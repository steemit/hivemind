# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
__pycache__/
# Root-level build artifacts only (anchored paths); bare `indexer`/`server`
# patterns would also ignore internal/indexer/ and internal/server/ sources.
/indexer
/server

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.cobertura.xml

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Build artifacts
bin/
dist/
build/
cmd/server/server
cmd/indexer/indexer

# Environment files
.env
.env.local

# Database
*.db
*.sqlite

# Logs
*.log
logs/

# API comparison run artifacts (reports + per-case detail files); the
# directory itself is kept via results/.gitkeep (2026-Q4 04 §一 1.8).
tests/api-comparison/results/*
!tests/api-comparison/results/.gitkeep

# OS
.DS_Store
Thumbs.db

