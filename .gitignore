# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# Root-level build artifacts only (anchored paths); bare `indexer`/`server`
# patterns would also ignore internal/indexer/ and internal/server/ sources.
/indexer
/server

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Build artifacts
bin/
dist/
build/
cmd/server/server
cmd/indexer/indexer

# Environment files
.env
.env.local

# Database
*.db
*.sqlite

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

