# Elastic Beanstalk configuration for the hivemind Go API server
# (planned PR#432, 05-deploy.md section 1.7).
#
# Platform: AWS Elastic Beanstalk "Docker" platform (AL2/AL2023, generic
# single-container). The container image itself comes from
# Dockerrun.aws.json (top level of this repo) - the CI image job publishes
# steemit/hivemind:server-<commit sha> on every push to next.
#
# No production EB template exists for the legacy stack, so this file
# follows the standard AWS EB Docker platform structure and encodes the
# hivemind deployment conventions (05-deploy.md sections 2 and 4):
#   - the load balancer is INTERNAL (test-env traffic enters via jussi /
#     the internal mesh; the API is never published on a public LB)
#   - the ELB health check targets the real /health endpoint (reader
#     semantics: 500 while the indexed head lags > HIVE_HEALTH_MAX_HEAD_AGE)
#   - HIVE_TELEMETRY_SERVICE_NAME=hivemind-go distinguishes Go spans/metrics
#     from the Python legacy service during the gray-release window
#
# Placeholder values (CHANGE_ME / required secrets) are set per environment
# via `eb create --envvars` / the EB console / `eb setenv` - DO NOT commit
# real credentials here.

option_settings:
  # ---------------------------------------------------------------------
  # Application environment variables (injected into the container).
  # ---------------------------------------------------------------------
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: HIVE_DATABASE_URL
    value: CHANGE_ME_RDS_URL
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: HIVE_STEEMD_URL
    value: https://api.steemit.com
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: HIVE_HTTP_SERVER_HOST
    value: 0.0.0.0
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: HIVE_HTTP_SERVER_PORT
    value: 8080
  # Reader tier: the indexer (deployed separately) owns schema migrations,
  # so API instances must not race migrations on boot.
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: HIVE_DB_MIGRATE
    value: "false"
  # Keep every statement under the jussi 5s HTTP timeout (05-deploy.md
  # section 4 rollout parameters).
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: HIVE_DB_STATEMENT_TIMEOUT
    value: 4s
  # Pool sizing matched to the instance spec: with the legacy default of 25
  # connections per instance, size the ASG so (instances x 25 + health pool)
  # stays under the RDS max_connections budget.
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: HIVE_DB_MAX_OPEN_CONNS
    value: "25"
  # Telemetry: OTLP collector endpoint (set to the in-VPC collector) and
  # the gray-release service name (05-deploy.md section 4: metrics/alerts
  # are sliced by service name; hivemind-go vs the Python legacy).
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: HIVE_TELEMETRY_SERVICE_NAME
    value: hivemind-go
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: HIVE_TRACES_ENDPOINT
    value: CHANGE_ME_OTLP_ENDPOINT
  # Set true only if the collector endpoint is TLS (HIVE_TRACES_TLS,
  # planned PR#432). Default false = insecure OTLP/HTTP (in-VPC collector).
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: HIVE_TRACES_TLS
    value: "false"
  # /health head-lag threshold for readers (legacy max_head_age). CATCH-UP
  # DEPLOYMENTS (05-deploy.md section 2 note 5): right after the Go indexer
  # takes over the database, the indexed head can be hours behind and /health
  # would 500, making EB recycle instances in a restart loop. Either set the
  # grace period below >= the catch-up ETA, or temporarily set this to "0"
  # (disables the lag criterion) and restore "1h" once converged.
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: HIVE_HEALTH_MAX_HEAD_AGE
    value: 1h

  # ---------------------------------------------------------------------
  # Load balancer: internal, application load balancer. Only port 8080
  # (JSON-RPC) is exposed through the proxy; the observability port
  # (HIVE_PROMETHEUS_PORT: /metrics + /debug/pprof) must NEVER be exposed
  # on the ELB - reach it via the instance security group from the
  # internal monitoring subnet only (PR#430 audit item 1).
  # ---------------------------------------------------------------------
  - namespace: aws:elasticbeanstalk:environment
    option_name: LoadBalancerType
    value: application
  - namespace: aws:elasticbeanstalk:environment
    option_name: LoadBalancerScheme
    value: internal

  # ---------------------------------------------------------------------
  # Default process (nginx -> container port 8080): real health check on
  # /health. The health endpoint also answers /.well-known/healthcheck.json.
  # ---------------------------------------------------------------------
  - namespace: aws:elasticbeanstalk:environment:process.default
    option_name: Port
    value: "8080"
  - namespace: aws:elasticbeanstalk:environment:process.default
    option_name: Protocol
    value: HTTP
  - namespace: aws:elasticbeanstalk:environment:process.default
    option_name: HealthCheckPath
    value: /health
  - namespace: aws:elasticbeanstalk:environment:process.default
    option_name: HealthCheckIntervalSeconds
    value: "15"
  - namespace: aws:elasticbeanstalk:environment:process.default
    option_name: HealthCheckTimeoutSeconds
    value: "10"
  - namespace: aws:elasticbeanstalk:environment:process.default
    option_name: MatcherHTTPCode
    value: "200"
  - namespace: aws:elasticbeanstalk:environment:process.default
    option_name: HealthyThresholdCount
    value: "2"
  - namespace: aws:elasticbeanstalk:environment:process.default
    option_name: UnhealthyThresholdCount
    value: "3"

  # ---------------------------------------------------------------------
  # Health check grace period (05-deploy.md section 2 note 5): during
  # indexer catch-up the reader /health answers 500 by design; 3600s keeps
  # the ASG from recycling instances for the first hour after boot. For a
  # cold takeover (catch-up ETA of hours) raise this or temporarily set
  # HIVE_HEALTH_MAX_HEAD_AGE=0 as noted above.
  # ---------------------------------------------------------------------
  - namespace: aws:autoscaling:asg
    option_name: HealthGracePeriod
    value: "3600"

  # ---------------------------------------------------------------------
  # Instance profile: the API server is read-only against RDS; 1 vCPU per
  # instance keeps the 25-connection pool proportionate. Adjust together
  # with HIVE_DB_MAX_OPEN_CONNS and the RDS max_connections budget.
  # ---------------------------------------------------------------------
  - namespace: aws:autoscaling:launchtemplate
    option_name: InstanceType
    value: c5.large
